; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="RoadmanSimulator"
config/version="dev"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="RoadmanSimulator"

[autoload]

Events="*res://scripts/autoload/Events.cs"
GameState="*res://scripts/autoload/GameState.cs"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="RoadmanSimulator"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[importer_defaults]

scene={
"meshes/create_shadow_meshes": true,
"meshes/force_disable_compression": true,
"meshes/generate_lods": false,
"meshes/light_baking": 1,
"nodes/use_name_suffixes": true
}

